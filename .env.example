# ─────────────────────────────────────────────────────────────────────────────
# EvalLib — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env (see .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM access ───────────────────────────────────────────────────────────────
# LLM_MODE controls how the mock gateway and eval judges call models.
#   mock      → no network calls; deterministic canned responses (default).
#   anthropic → real Anthropic API calls (requires ANTHROPIC_API_KEY below).
LLM_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default models (used in anthropic mode; ignored in mock mode)
GATEWAY_DEFAULT_MODEL=claude-sonnet-4-6
JUDGE_DEFAULT_MODEL=claude-sonnet-4-6

# ── OpenTelemetry ────────────────────────────────────────────────────────────
# Where services export spans/metrics/logs. Points at the collector by default.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
DEPLOYMENT_ENVIRONMENT=poc
SERVICE_NAMESPACE=evallib
# When "true", message/prompt content is captured as span events (OTel GenAI spec).
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# ── Phoenix ──────────────────────────────────────────────────────────────────
# Phoenix image is pinned here for reproducibility; bump deliberately.
PHOENIX_IMAGE=arizephoenix/phoenix:latest
# Phoenix collector endpoint (gRPC) reachable from the collector container.
PHOENIX_OTLP_ENDPOINT=http://phoenix:4317
# Base URL the orchestrator + UI use to query/deep-link Phoenix.
PHOENIX_BASE_URL=http://phoenix:6006

# ── Governance Store (Postgres) ──────────────────────────────────────────────
POSTGRES_USER=evallib
POSTGRES_PASSWORD=evallib_dev_pw
POSTGRES_DB=evallib
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full SQLAlchemy URL assembled from the parts above (override if needed).
DATABASE_URL=postgresql+psycopg://evallib:evallib_dev_pw@postgres:5432/evallib

# ── Service URLs (intra-cluster) ─────────────────────────────────────────────
GOVERNANCE_API_URL=http://governance-api:8001
EVAL_ORCHESTRATOR_URL=http://eval-orchestrator:8002
GATEWAY_URL=http://mock-gateway:8080

# ── UI ───────────────────────────────────────────────────────────────────────
# Browser-facing URLs (host ports), injected at build/runtime.
VITE_GOVERNANCE_API_URL=http://localhost:8001
VITE_PHOENIX_URL=http://localhost:6006
VITE_ORCHESTRATOR_URL=http://localhost:8002
